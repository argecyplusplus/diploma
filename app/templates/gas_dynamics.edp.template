int S1 = {{S1}};
real Chord1 = {{Chord1}};
real RC = 3. * Chord1;

border C(t=0, 2*pi){ x=Chord1/2. + RC*cos(t); y=RC*sin(t); }

real beta = {{beta}};
real B = {{B}};
real rho = {{rho}};

load "iovtk"
int plotCounter = 0;
string plotName;

real[int] coeffsUp(10);
real[int] coeffsLow(10);
ifstream fl("out_L_blade.csv");
for(int i=0; i<coeffsUp.n; i++) fl >> coeffsUp(i);
for(int i=0; i<coeffsLow.n; i++) fl >> coeffsLow(i);

func real Lezh(real[int] L, real t) {
    real[int] yy(10);
    yy(0)=1.; yy(1)=t; yy(2)=(3.*t^2-1.)/2.; yy(3)=(5.*t^3-3.*t)/2.;
    yy(4)=(35.*t^4-30.*t^2+3.)/8.; yy(5)=(63.*t^5-70.*t^3+15.*t)/8.;
    yy(6)=231./16.*t^6-315./16.*t^4+105./16.*t^2-5./16.;
    yy(7)=429./16.*t^7-693./16.*t^5+315./16.*t^3-35./16.*t;
    yy(8)=6435./128.*t^8-3003./32.*t^6+3465./64.*t^4-315./32.*t^2+35./128.;
    yy(9)=12155./128.*t^9-6435./32.*t^7+9009./64.*t^5-1155./32.*t^3+315./128.*t;
    return L'*yy;
}

border Splus(t=0., 1.){ x=Chord1*t; y=Chord1*Lezh(coeffsUp,t); label=S1; }
border Sminus(t=1., 0.){ x=Chord1*t; y=Chord1*Lezh(coeffsLow,t); label=S1; }
border Spm(t=0,1.){ x=0; y=Chord1*Lezh(coeffsLow,0)+t*Chord1*(Lezh(coeffsUp,0)-Lezh(coeffsLow,0)); label=S1; }
border Smp(t=1.,0.){ x=Chord1; y=Chord1*Lezh(coeffsLow,1)+t*Chord1*(Lezh(coeffsUp,1)-Lezh(coeffsLow,1)); label=S1; }

real xblade = Chord1*0.25, yblade = Chord1*(Lezh(coeffsUp,0.5)+Lezh(coeffsLow,0.5))/2;
mesh Th = buildmesh(C({{NC}})+Splus({{NSp}})+Spm({{NSpm}})+Sminus({{NSm}})+Smp({{NSpm}}));
plotCounter++;
plotName = "plot_"+plotCounter+".eps";
plot(Th, wait=1, ps=plotName);

fespace Vh(Th, P2);
Vh psi, w, vx, vy, p;
real cost = cos(beta*pi/180.), sint=sin(beta*pi/180.);

solve potential(psi, w)
  = int2d(Th)(dx(psi)*dx(w)+dy(psi)*dy(w))
  + on(C, psi = cost*y - sint*x)
  + on(S1, psi=0);
vx = dx(psi); vy = dy(psi);
p = 1 - rho/(2*B)*(vx^2+vy^2);

plotCounter++;
plotName = "plot_"+plotCounter+".eps";
plot(psi, wait=1, fill=1, value=1, ps=plotName);
plotCounter++;
plotName = "plot_"+plotCounter+".eps";
plot([vx,vy], wait=1, value=1, ps=plotName);
plotCounter++;
plotName = "plot_"+plotCounter+".eps";
plot(p, wait=1, fill=1, value=1, ps=plotName);
plotCounter++;
plotName = "plot_"+plotCounter+".eps";
plot(p, wait=1, nbiso=20, value=1, ps=plotName);

int blade = Th(xblade, yblade).region, outspace=Th(-1, -1).region;
cout << blade << " " << outspace << endl;

Vh pblade = p*(region==blade);
Vh poutspace = p*(region==outspace);
cout << "max p blade = " << pblade[].max << endl;
cout << "min p blade = " << pblade[].min << endl;
cout << "max p outspace = " << poutspace[].max << endl;
cout << "min p outspace = " << poutspace[].min << endl;

savevtk("result.vtk", Th, p);

// ========== ТЕПЛОВОЙ РАСЧЁТ ==========
real dt = {{dt}};
real nbT = {{nbT}};
real Tinitial = {{T_initial}};
real ksteel = {{ksteel}};
real kair = {{kair}};

border D(t=0, 2.){ x=0.5+t*cost; y=+t*sint; }
mesh Sh = buildmesh(C({{NC}}) + Splus(-90) + Spm(-2) + Sminus(-90) + Smp(-2) + D(200));
int steel = Sh(xblade, yblade).region, air = Sh(-1, -1).region;

fespace Wh(Sh, P1);
Wh vv;

fespace W0(Sh, P0);
W0 k = kair*(region == air) + ksteel*(region == steel);
W0 u1 = dy(psi)*(region == air), u2 = -dx(psi)*(region == air);
Wh v = Tinitial*(region == steel), vold;

Sh = change(Sh, flabel = (label == C && [u1,u2]'*N < 0) ? 10 : label);

problem thermic(v, vv, solver=LU)
  = int2d(Sh)(
      v*vv/dt + k*(dx(v)*dx(vv)+dy(v)*dy(vv)) + 10*(u1*dx(v)+u2*dy(v))*vv
    )
  - int2d(Sh)(vold*vv/dt)
  + on(10, v=0);

for(int i=0; i<nbT; i++) {
    vold[] = v[];
    thermic;
    plotCounter++;
    plotName = "temp_" + i + ".eps";
    plot(v, wait=1, fill=1, value=1, ps=plotName);
}
plotName = "temp_final.eps";
plot(v, wait=1, nbiso=20, value=1, ps=plotName);